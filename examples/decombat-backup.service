# One backup run (tools/vps/backup.sh, OPS-20, docs/OPS.md). As root: it reads the config and keys and owns the backup folder;
# the database copy itself is made as the service user. NOT RUN ON A LINUX VPS YET.
[Unit]
Description=DeCombat encrypted backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/decombat/tools/backup.sh
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
